ENVIRONMENT=development

DB_HOST=postgres
DB_PORT=5432
DB_NAME=riverbend
DB_USER=riverbend_app
DB_PASSWORD=changeme

# Redis is no longer host-published and now requires a password (debt-log D3b).
# The credential is deliberately NOT in this URL and NOT in this file: compose
# loads .env into every service, so a credential here is a credential for all of
# them. It lives in the scoped .env.redis (template: .env.redis.example),
# loaded by exactly redis + gateway, and `make up` generates a random one.
# The gateway REFUSES to connect without it — sessions and visit memory are not
# allowed onto an unauthenticated store.
REDIS_URL=redis://redis:6379/0

PAYER_API_URL=https://edi.example.com/v1/eligibility
PAYER_API_KEY=changeme

# --- Eligibility resilience (eligibility-service + intake-service, ADR 0010) --
# Bound the payer call so a slow/hung clearinghouse can no longer freeze intake
# (RIV-088 / RIV-141). All have safe defaults in each service's config.py; these
# are conservative starting points pending the real clearinghouse SLA. Timeouts
# in seconds. Retries cover only timeout/connection/5xx, never a 4xx (a 404 is a
# definitive "inactive coverage" answer). The breaker is per-worker/in-process.
# INVARIANT: (connect + read) * (max_retries + 1) must stay below
# ELIGIBILITY_TIMEOUT_SECONDS with margin — here (1+2)*2 = 6s < 8s — so intake
# gets eligibility's graceful "unknown" instead of abandoning a running call.
PAYER_CONNECT_TIMEOUT_SECONDS=1
PAYER_READ_TIMEOUT_SECONDS=2
PAYER_MAX_RETRIES=1
PAYER_BREAKER_FAIL_THRESHOLD=5
PAYER_BREAKER_RESET_SECONDS=30
# Hard cap (seconds) on intake's call to eligibility — the real RIV-141 guard:
# a slow payer times out here and intake returns eligibility status "pending"
# rather than blocking the /intake request thread. Kept above the payer budget
# (6s) so intake receives the graceful degraded answer first.
ELIGIBILITY_TIMEOUT_SECONDS=8
# Intake-side breaker on the intake -> eligibility hop. The timeout above bounds
# ONE registration; this bounds the sustained cost of a wedged dependency: after
# this many consecutive unusable answers intake skips verification entirely
# (status "pending", no outbound call) until the reset window elapses. Threshold
# is below the payer one because intake pays up to 8s per failed call where the
# payer path pays 3s. Per-worker state, like the payer breaker.
ELIGIBILITY_BREAKER_FAIL_THRESHOLD=3
ELIGIBILITY_BREAKER_RESET_SECONDS=30
# How long a degraded eligibility answer (HTTP 200, status "unknown", no coverage
# verdict) must have held the intake worker before it counts against the breaker
# above. eligibility-service emits that same answer instantly when its own payer
# breaker is open — free, so intake keeps calling — and after burning the whole
# payer budget on a hanging payer, which is the sustained cost RIV-088 is about.
# INVARIANT: 0.1 <= this <= PAYER_CONNECT_TIMEOUT_SECONDS. Upper bound so a
# hanging payer lands on the slow side, lower bound so one local round trip does
# not. A payer that fails instantly (connection refused, bad API key) reads as
# free, which is right — it pins no worker.
ELIGIBILITY_DEGRADED_SLOW_SECONDS=1
# The same rule for an answer that DID carry a coverage verdict: past this many
# seconds it counts against the breaker as well. The verdict is still returned —
# a slow answer is worth having — but a payer that degrades without going dark
# (first attempt read-times-out, the retry answers) would otherwise make every
# registration pay for as long as the degradation lasts. A verdict gets a longer
# leash than a degraded reply because it is worth more.
# INVARIANT: ELIGIBILITY_DEGRADED_SLOW_SECONDS <= this <=
# PAYER_READ_TIMEOUT_SECONDS. The upper bound is the FLOOR of the retried band —
# a retry only happens after the first attempt's read timeout burned in full — so
# anchoring above it (an earlier draft used 4s = one healthy attempt's ceiling)
# makes the check dead code: the degrading payer answers in 2-4s and still reads
# as healthy. Raising PAYER_READ_TIMEOUT_SECONDS raises this ceiling with it.
ELIGIBILITY_SLOW_ANSWER_SECONDS=2

# --- Registration fan-out: gateway -> intake-service (E4-SPEC-17/18) --------
# Bound on the gateway's POST /intake call. Same 30s the inherited proxy helper
# hardcoded, now configured — and pinned, because a registration can spend up to
# ELIGIBILITY_TIMEOUT_SECONDS on the request thread verifying coverage AND up to
# REGISTRATION_LOCK_WAIT_SECONDS waiting on the idempotency arbiter (e5b).
# INVARIANT: this must stay at least REGISTRATION_LOCK_WAIT_SECONDS + 1s above
# ELIGIBILITY_TIMEOUT_SECONDS, or the gateway gives up on a registration intake
# is still legitimately processing and the desk is told the system failed while
# a patient row is being written. Today 8 + 5 + 1 = 14 <= 30. Enforced by
# tests/test_eligibility_budget_alignment.py against both this file and the code
# default; tests/test_compose_topology.py keeps the value reaching the gateway
# from this one place.
INTAKE_TIMEOUT_SECONDS=30

# Bounded wait on the registration idempotency arbiter (e5b-SPEC-8). Issued as
# Postgres lock_timeout on the registration transaction: a concurrent retry of
# the same submission_id blocks on the UNIQUE index at most this long, then
# replays the winner or (on expiry) answers in the system-failure branch. Enters
# intake's request-thread budget — see the INVARIANT above. No fingerprint key
# here: it is generated into the gitignored .env.registration (e5b-D-13), never
# templated.
REGISTRATION_LOCK_WAIT_SECONDS=5

HL7_FEED_HOST=hl7.example.org
HL7_FEED_PORT=2575

SESSION_SECRET=changeme

# AWS Bedrock (ai-assistant service, see ADR 0005). Copy this file to .env
# (gitignored, never tracked) and add your real Bedrock bearer API key there
# only. AWS_BEARER_TOKEN_BEDROCK is read directly by boto3/botocore — never by
# app code — so it never lands in a config object, log, or exception message.
# BEDROCK_MODEL_ID / AWS_REGION must match a model+region your Bedrock account
# can invoke (and, for real PHI, that your AWS BAA covers). Note: an older .env
# was previously committed — those values are still in git history and must be
# rotated (see docs/debt-log.md remediation runbook).
# The ai-assistant FAILS CLOSED without this key: it refuses every LLM call
# rather than fall back to ambient AWS credentials (instance role, AWS_* env).
# Shipped EMPTY on purpose so a copied example config fails closed by default —
# CI seeds .env via `cp .env.example .env`, and a non-empty placeholder (e.g.
# "changeme") would satisfy a bare presence check and let a misconfigured
# deploy egress PHI before AWS rejects the auth. Set the real bearer key in
# .env only; the guard also rejects known placeholder sentinels.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# claude-sonnet-4-6 (the model the eval in docs/research/ recommends, ADR 0005)
# is INFERENCE_PROFILE-only on Bedrock (the bare anthropic.claude-sonnet-4-6 id
# is NOT invokable on-demand). Use a region-scoped inference profile id; verify
# the exact one for your account/region with:
#   aws bedrock list-inference-profiles --region <region>
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# The cost gate fails closed per model: a BEDROCK_MODEL_ID with no entry in
# llm_client._MODEL_PRICING refuses every call unless BOTH overrides below are
# set (USD per million tokens). Set both or neither.
# LLM_PRICE_PER_MTOK_INPUT=3.00
# LLM_PRICE_PER_MTOK_OUTPUT=15.00

# --- Paid LLM abuse control: gateway per-user quota (Codex PR #7 round 6) --
# The /ai fan-out only checks "is logged in", and sessions never expire, so the
# gateway enforces a per-user fixed-window Redis quota before calling Bedrock:
# the minute window absorbs double-clicks/retries, the per-user daily cap
# bounds one user's volume. Non-secret; safe to keep in .env. Fails closed if
# Redis is unreachable (the request will not proceed). See adr/0007.
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=200
# Aggregate daily ceiling over *paid* fan-outs across ALL users — the real
# spend bound (per-user caps alone are unbounded in user count). Counted only
# on a cache miss. <=0 disables. Size ~= expected active staff * per-user cap.
AI_RATE_LIMIT_GLOBAL_PER_DAY=2000
# Response cache TTL (seconds) for the closed-vocabulary intake-instructions
# endpoint: identical facts -> same checklist, so caching cuts spend + latency
# and collapses retry storms. Keyed by a hash of the (non-PHI) request body.
# <=0 disables. TTL bounds staleness against catalog/template deploys.
AI_CACHE_TTL_SECONDS=300
# Single-flight coalescing of CONCURRENT identical cache misses (Codex PR #7
# round 7, closes ADR 0007 gap #4). The cache collapses sequential retries; a
# SET NX lock collapses simultaneous ones (double-click / retry storm) so only
# one paid fan-out happens. Losers wait AI_SINGLEFLIGHT_WAIT_SECONDS (polling
# every AI_SINGLEFLIGHT_POLL_SECONDS) for the winner's result, else get a
# controlled 429. Lock TTL must outlive the slowest fan-out so a crashed
# winner's lock self-clears; defaults just above AI_READ_TIMEOUT_SECONDS.
AI_SINGLEFLIGHT_WAIT_SECONDS=2.0
AI_SINGLEFLIGHT_POLL_SECONDS=0.1
AI_SINGLEFLIGHT_LOCK_TTL_SECONDS=75

# --- Visit chat: front-desk eligibility assistant (ADR 0011) ---------------
# The chat endpoint gets its OWN per-user quota namespace (ratelimit:aichat:*),
# higher than the one-shot endpoint's because a conversation is many turns.
# Neither endpoint can exhaust the other's quota; both share the aggregate
# AI_RATE_LIMIT_GLOBAL_PER_DAY spend ceiling above, which bounds dollars.
AI_CHAT_RATE_LIMIT_PER_MINUTE=20
AI_CHAT_RATE_LIMIT_PER_DAY=400
# Visit memory retention. This TTL is a PHI retention policy, not a cache knob:
# visit memory holds a payer member id plus a structured coverage verdict, and
# this is the upper bound on how long that survives in Redis. Sliding — every
# turn refreshes it — so it means "30 min after the LAST turn". The Redis
# hardening this feature depended on (debt-log D3b) shipped with it: the store
# is compose-internal and password-protected (see .env.redis.example).
AI_VISIT_TTL_SECONDS=1800
# Hard caps on one visit: the transcript window and the per-message length.
# Both bound token spend AND the size of a hypothetical exposure. The store
# truncates to these rather than trusting callers.
AI_VISIT_MAX_TURNS=12
AI_VISIT_MAX_MESSAGE_CHARS=1000
# ai-assistant -> eligibility-service hop (the chat's own dependency). Bounded
# and breakered from day one: the D4 lesson is about the CALLER's worker thread,
# so a new caller inherits the problem, not the fix.
# INVARIANT: this timeout must exceed eligibility-service's worst-case payer
# budget ((PAYER_CONNECT + PAYER_READ) * (1 + PAYER_MAX_RETRIES) = 6s with the
# values above), or this client gives up while the downstream is still doing
# bounded, useful work.
AI_ELIGIBILITY_TIMEOUT_SECONDS=8
AI_ELIGIBILITY_BREAKER_FAIL_THRESHOLD=3
AI_ELIGIBILITY_BREAKER_RESET_SECONDS=30
# Breaker health is "usable AND cheap" on two latency thresholds — the rule
# intake landed on in PR #11 rounds r5/r6, because eligibility-service returns
# the identical shaped 200 {"active":null,"status":"unknown"} whether its payer
# breaker short-circuited (free) or it burned the whole payer budget (expensive).
# INVARIANT: 0.1 <= DEGRADED <= SLOW_ANSWER <= PAYER_READ_TIMEOUT_SECONDS. The
# upper bound is the FLOOR of the retried band; anchoring higher makes the check
# dead code for a payer that degrades but keeps answering.
AI_ELIGIBILITY_DEGRADED_SLOW_SECONDS=1
AI_ELIGIBILITY_SLOW_ANSWER_SECONDS=2
# How long a DEFINITIVE verdict a visit already holds answers a REPEAT of the
# same member id, instead of spending another PHI-bearing payer call. A clerk
# re-pasting the id is normal, and every repeat used to pay again. Per-visit
# reuse of state the visit already carries — not a shared verdict cache (ADR
# 0011 gap 7): degraded unknown/pending verdicts are always re-checked, and a
# reused verdict is always rendered with its checked_at stamp.
# 0 disables reuse (always call the payer — the strictest-freshness setting).
# Clamped to 1800s, the visit retention window above: reuse must never outlive
# the visit that holds the verdict.
AI_ELIGIBILITY_REUSE_SECONDS=300

# --- Eligibility assistant: the wired agent turn (ADR 0019) ----------------
# Both template-only, no secret. A1_RETRIEVAL_MAX_ROWS caps one retrieval's
# row count; 5 is sized so cap x MAX_ROW_BYTES + the prompt reserve stays
# under LLM_MAX_INPUT_TOKENS (policy_index.PROMPT_RESERVE_BYTES).
A1_RETRIEVAL_MAX_ROWS=5
# Deliberately fail-VISIBLE, not fail-silent: while true, every model-produced
# reply reports mode "fixture", so a flag left on in a real deploy shows up on
# the surface rather than silently claiming live answers.
A1_MODEL_FIXTURE=false

# --- Service-to-service auth: gateway -> ai-assistant ----------------------
# AI_PROXY_SHARED_SECRET deliberately does NOT live in this file: compose
# loads .env into every service, so a value here would hand the secret to
# intake/eligibility/records/scheduling/interop/roi too, and any holder can
# bypass the gateway session check on the paid LLM path. It lives in
# .env.ai-proxy (template: .env.ai-proxy.example), loaded by exactly gateway
# and ai-assistant. Guarded by tests/test_compose_topology.py.

# --- Observability: LangSmith tracing (ai-assistant, see ADR 0006) ---------
# OFF by default. Metadata-only: prompt/completion payloads are NEVER sent to
# LangSmith. PHI is blanked in TWO independent layers — the LangSmith Client is
# built with hide callables in code (services/ai-assistant/tracing.py) AND the
# LANGSMITH_HIDE_* vars below blank inputs/outputs via config — so neither a
# code regression nor a flipped env var alone can leak PHI. Metadata-only cloud
# traces carry no PHI, so no BAA is required to enable this; capturing actual
# prompts/completions would require an Enterprise BAA or a self-hosted LangSmith
# (ADR 0006 Future / D13 gate). Enabling: set LANGSMITH_TRACING=true and put a
# real key in LANGSMITH_API_KEY.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=Riverbend
# The ONLY secret here. Like the Bedrock bearer key, set it in .env ONLY (never
# committed) and shipped EMPTY so a copied example config traces nothing.
LANGSMITH_API_KEY=
# PHI guard — LEAVE THESE true. They blank inputs/outputs before egress;
# flipping either to false would send prompts/completions (PHI) to LangSmith
# and is gated on an Enterprise BAA or self-host (ADR 0006).
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
