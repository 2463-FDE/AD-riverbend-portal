{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/phi-secret-guard.sh\"",
            "timeout": 15,
            "statusMessage": "Scanning staged diff for PHI/secrets..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-pr-status.sh\"",
            "timeout": 15,
            "statusMessage": "Fetching repo/PR state..."
          }
        ]
      }
    ]
  }
}
