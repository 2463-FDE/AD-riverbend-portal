{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/deny-no-verify.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for --no-verify..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/syntax-check.sh\"",
            "timeout": 30,
            "statusMessage": "Parse-checking the edited file..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-pr-status.sh\"",
            "timeout": 15,
            "statusMessage": "Fetching repo/PR state..."
          }
        ]
      }
    ]
  }
}
