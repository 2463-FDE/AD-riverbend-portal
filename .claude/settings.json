{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/phi-secret-guard.sh\"",
            "timeout": 15,
            "statusMessage": "Scanning staged diff for PHI/secrets..."
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/xfail-invariant.sh\"",
            "timeout": 600,
            "statusMessage": "Checking the xfail/deselected invariant..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/syntax-check.sh\"",
            "timeout": 30,
            "statusMessage": "Parse-checking the edited file..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-pr-status.sh\"",
            "timeout": 15,
            "statusMessage": "Fetching repo/PR state..."
          }
        ]
      }
    ]
  }
}
