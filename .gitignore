node_modules/
*.pyc
__pycache__/
.next/
dist/
.DS_Store
# Local env files hold real credentials (DB, payer, session secret, Anthropic
# key) — never track them. Template lives in .env.example. NOTE: the previously
# tracked .env is still in git history; rotation + history scrub are tracked in
# docs/debt-log.md (remediation runbook).
.env
.env.local
# Scoped gateway->ai-assistant secret (template: .env.ai-proxy.example)
.env.ai-proxy
# Scoped redis+gateway secret, generated per machine by `make up`
# (template: .env.redis.example)
.env.redis

# Application logs may contain PHI (see docs/phi-logging-policy.md) — never track them.
*.log
*.log.1
*.log.2
.venv/

# Claude Code tooling (skills, hooks, commands, agents, workflows, settings) is
# TRACKED as of 2026-08-05 (docs/plans/pipeline-upgrade.md OD-1; untracked
# 2026-07-30 to 2026-08-05) so clones and worktrees carry identical pipeline
# tooling and changes get PR review. CI still cannot RUN any of it — hooks
# execute only inside Claude Code sessions; anything that must gate a merge
# belongs in .github/workflows/ or the Makefile. Machine-local state stays out:
.claude/settings.local.json
.claude/scheduled_tasks.lock
# Claude Code runtime state (was hidden by this machine's .git/info/exclude,
# which clones don't inherit — the worktrees/ entry matters most: agent-created
# worktree dirs land there, and their stale repo copies `git add -A` would
# otherwise stage into a HIPAA repo).
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/scheduled_tasks.json
.claude/routines/.state/
.claude/agent-registry.json
.claude/agent-memory-local
.claude/first-run
.claude/assistant-daemon-state.json
# The frontend-rebuild gate tracker is retired (TODO-23; G0-G6 is dead
# vocabulary) — its scripts stay local-only, never tracked.
.claude/gates/
.claude/commands/gates.md
.claude/hooks/gate-statusline.sh

# CLAUDE.md was ignored here 2026-08-05 (PR #32) and re-tracked the same day
# (docs/plans/pipeline-upgrade.md PIPE-1, reversing #32): parallel worktrees and
# fresh clones must inherit the rules, the in-repo doc references must resolve,
# and rule changes get PR review. Edits to it are approval-gated (CLAUDE.md §7).

# Local-only helper scripts (renderers and similar). Same reasoning as .claude/ above:
# they are personal tooling, not a project deliverable, so they stay out of git. No
# Makefile target depends on anything here — `make status` and its generator were
# retired with the frontend rebuild, and a target that needs an untracked file to run
# does not belong in a tracked Makefile.
scripts/

# `make seed-gen` writes here and renames onto db/seed/seed.sql on success, so a
# failed generation cannot truncate the file a fresh Postgres volume loads. Only
# ever present if the recipe was interrupted between the two steps.
db/seed/seed.sql.tmp
