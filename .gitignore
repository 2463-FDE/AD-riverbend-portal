node_modules/
*.pyc
__pycache__/
.next/
dist/
.DS_Store
# Local env files hold real credentials (DB, payer, session secret, Anthropic
# key) — never track them. Template lives in .env.example. NOTE: the previously
# tracked .env is still in git history; rotation + history scrub are tracked in
# docs/debt-log.md (remediation runbook).
.env
.env.local
# Scoped gateway->ai-assistant secret (template: .env.ai-proxy.example)
.env.ai-proxy
# Scoped redis+gateway secret, generated per machine by `make up`
# (template: .env.redis.example)
.env.redis

# Application logs may contain PHI (see docs/phi-logging-policy.md) — never track them.
*.log
*.log.1
*.log.2
.venv/

# Claude Code tooling (skills, hooks, commands, settings) — untracked as of
# 2026-07-30 so it stays identical across branches and commits. Rationale and the
# accepted trade-offs are in CLAUDE.md §10.1. Note the consequences: a fresh clone
# arrives with no tooling, and CI cannot run any of it, so anything that must gate a
# merge belongs in .github/workflows/ or the Makefile instead.
.claude/

# Local-only helper scripts (status dashboard generator, renderers). Same reasoning as
# .claude/ above: they are personal tooling, not a project deliverable, so they stay out
# of git. `make status` guards on their absence rather than failing obscurely.
scripts/

# Status dashboard — derived from docs/specs/, docs/todo.md and docs/debt-log.md by
# `make status`. The inputs are tracked; the render is not, so it cannot drift from them.
docs/status/dashboard.html
docs/status/snapshot.json
